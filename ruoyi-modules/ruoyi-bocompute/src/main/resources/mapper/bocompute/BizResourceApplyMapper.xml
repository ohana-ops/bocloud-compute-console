<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.bocompute.mapper.BizResourceApplyMapper">

	<resultMap type="BizResourceApply" id="BizResourceApplyResult">
		<id     property="applyId"        column="apply_id"        />
		<result property="applyNo"        column="apply_no"        />
		<result property="resourceId"     column="resource_id"     />
		<result property="resourceName"   column="resource_name"   />
		<result property="resourceType"   column="resource_type"   />
		<result property="applyCount"     column="apply_count"     />
		<result property="applyUserId"    column="apply_user_id"   />
		<result property="applyUserName"  column="apply_user_name" />
		<result property="applyDeptId"    column="apply_dept_id"   />
		<result property="applyDeptName"  column="apply_dept_name" />
		<result property="purpose"        column="purpose"         />
		<result property="beginTime"      column="begin_time"      />
		<result property="endTime"        column="end_time"        />
		<result property="status"         column="status"          />
		<result property="auditBy"        column="audit_by"        />
		<result property="auditTime"      column="audit_time"      />
		<result property="auditOpinion"   column="audit_opinion"   />
		<result property="delFlag"        column="del_flag"        />
		<result property="createBy"       column="create_by"       />
		<result property="createTime"     column="create_time"     />
		<result property="updateBy"       column="update_by"       />
		<result property="updateTime"     column="update_time"     />
		<result property="remark"         column="remark"          />
	</resultMap>

	<sql id="selectBizResourceApplyVo">
        select apply_id, apply_no, resource_id, resource_name, resource_type, apply_count,
               apply_user_id, apply_user_name, apply_dept_id, apply_dept_name, purpose,
               begin_time, end_time, status, audit_by, audit_time, audit_opinion, del_flag,
               create_by, create_time, update_by, update_time, remark
		from biz_resource_apply
    </sql>

	<select id="selectBizResourceApplyList" parameterType="BizResourceApply" resultMap="BizResourceApplyResult">
	    <include refid="selectBizResourceApplyVo"/>
		<where>
			del_flag = '0'
			<if test="applyNo != null and applyNo != ''">
				AND apply_no like concat('%', #{applyNo}, '%')
			</if>
			<if test="resourceName != null and resourceName != ''">
				AND resource_name like concat('%', #{resourceName}, '%')
			</if>
			<if test="resourceType != null and resourceType != ''">
				AND resource_type = #{resourceType}
			</if>
			<if test="applyUserName != null and applyUserName != ''">
				AND apply_user_name like concat('%', #{applyUserName}, '%')
			</if>
			<if test="applyUserId != null">
				AND apply_user_id = #{applyUserId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
		order by apply_id desc
	</select>

	<select id="selectBizResourceApplyById" parameterType="Long" resultMap="BizResourceApplyResult">
		<include refid="selectBizResourceApplyVo"/>
		where apply_id = #{applyId}
	</select>

	<!-- 统计待审批申请单数量 -->
	<select id="countPendingApply" resultType="int">
		select count(1) from biz_resource_apply where del_flag = '0' and status = '0'
	</select>

	<!-- 统计本月申请单数量 -->
	<select id="countCurrentMonthApply" resultType="int">
		select count(1) from biz_resource_apply
		where del_flag = '0'
		  and date_format(create_time, '%Y%m') = date_format(sysdate(), '%Y%m')
	</select>

	<insert id="insertBizResourceApply" parameterType="BizResourceApply" useGeneratedKeys="true" keyProperty="applyId">
 		insert into biz_resource_apply(
 			<if test="applyNo != null and applyNo != ''">apply_no,</if>
 			<if test="resourceId != null">resource_id,</if>
 			<if test="resourceName != null">resource_name,</if>
 			<if test="resourceType != null">resource_type,</if>
 			<if test="applyCount != null">apply_count,</if>
 			<if test="applyUserId != null">apply_user_id,</if>
 			<if test="applyUserName != null">apply_user_name,</if>
 			<if test="applyDeptId != null">apply_dept_id,</if>
 			<if test="applyDeptName != null">apply_dept_name,</if>
 			<if test="purpose != null">purpose,</if>
 			<if test="beginTime != null">begin_time,</if>
 			<if test="endTime != null">end_time,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="remark != null">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="applyNo != null and applyNo != ''">#{applyNo},</if>
 			<if test="resourceId != null">#{resourceId},</if>
 			<if test="resourceName != null">#{resourceName},</if>
 			<if test="resourceType != null">#{resourceType},</if>
 			<if test="applyCount != null">#{applyCount},</if>
 			<if test="applyUserId != null">#{applyUserId},</if>
 			<if test="applyUserName != null">#{applyUserName},</if>
 			<if test="applyDeptId != null">#{applyDeptId},</if>
 			<if test="applyDeptName != null">#{applyDeptName},</if>
 			<if test="purpose != null">#{purpose},</if>
 			<if test="beginTime != null">#{beginTime},</if>
 			<if test="endTime != null">#{endTime},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="remark != null">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

	<update id="updateBizResourceApply" parameterType="BizResourceApply">
 		update biz_resource_apply
 		<set>
 			<if test="applyNo != null and applyNo != ''">apply_no = #{applyNo},</if>
 			<if test="resourceId != null">resource_id = #{resourceId},</if>
 			<if test="resourceName != null">resource_name = #{resourceName},</if>
 			<if test="resourceType != null">resource_type = #{resourceType},</if>
 			<if test="applyCount != null">apply_count = #{applyCount},</if>
 			<if test="applyUserId != null">apply_user_id = #{applyUserId},</if>
 			<if test="applyUserName != null">apply_user_name = #{applyUserName},</if>
 			<if test="applyDeptId != null">apply_dept_id = #{applyDeptId},</if>
 			<if test="applyDeptName != null">apply_dept_name = #{applyDeptName},</if>
 			<if test="purpose != null">purpose = #{purpose},</if>
 			<if test="beginTime != null">begin_time = #{beginTime},</if>
 			<if test="endTime != null">end_time = #{endTime},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="auditBy != null">audit_by = #{auditBy},</if>
 			<if test="auditTime != null">audit_time = #{auditTime},</if>
 			<if test="auditOpinion != null">audit_opinion = #{auditOpinion},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where apply_id = #{applyId}
	</update>

	<!-- 逻辑删除，保留历史数据 -->
	<update id="deleteBizResourceApplyById" parameterType="Long">
 		update biz_resource_apply set del_flag = '2' where apply_id = #{applyId}
	</update>

	<!-- 逻辑批量删除 -->
	<update id="deleteBizResourceApplyByIds" parameterType="Long">
 		update biz_resource_apply set del_flag = '2' where apply_id in
 		<foreach collection="array" item="applyId" open="(" separator="," close=")">
 			#{applyId}
        </foreach>
	</update>

</mapper>
